# Written by `npx convex dev`
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Public origin of the app (used for absolute OG image URLs)
VITE_SITE_URL=http://localhost:3030

# --- Set these on the Convex deployment with `npx convex env set`, not here ---
# AUTH_PRIVATE_KEY / AUTH_JWKS      -> `npx @convex-dev/auth` generates and sets them
# AUTH_GITHUB_CLIENT_ID / _SECRET   -> GitHub OAuth app; callback: <CONVEX_SITE_URL>/oauth/github/callback
# SITE_URL                          -> app origin(s), comma-separated; allowed OAuth redirect targets
# TMDB_API_KEY                      -> enables movies + shows (v3 key or v4 read token)
# IGDB_CLIENT_ID / _SECRET          -> enables games (Twitch developer app)
# AUTH_DEV_GUEST=true               -> dev only: one-click guest accounts
