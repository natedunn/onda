// Writes item art into the onda-images bucket for Convex; see README.md.
// Secret: wrangler secret put UPLOAD_TOKEN
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "onda-images",
	// The account that owns onda.club ("Nate").
	"account_id": "fc87b44f5832b25053fec2efb19fc208",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	// Only Convex calls it, so the workers.dev address is enough. Reads don't
	// come here: the bucket is public at https://img.onda.club.
	"workers_dev": true,
	"preview_urls": false,
	"observability": { "enabled": true },
	"r2_buckets": [{ "binding": "BUCKET", "bucket_name": "onda-images" }]
}
