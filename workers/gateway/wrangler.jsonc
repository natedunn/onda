// OAuth callback gateway. One Worker per tier; see docs/convex-auth.md.
// Secrets (per env): wrangler secret put ROUTING_SECRET --env <dev|prod>
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "onda-gateway",
	// The account that owns onda.club ("Nate").
	"account_id": "fc87b44f5832b25053fec2efb19fc208",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true },
	// Local `wrangler dev` only.
	"vars": { "ALLOWED_TARGETS": "http://127.0.0.1:*,http://localhost:*" },
	"env": {
		"dev": {
			"name": "onda-gateway-dev",
			"routes": [{ "pattern": "gateway-dev.onda.club", "zone_name": "onda.club", "custom_domain": true }],
			// Local worktrees (the browser follows the redirect, so loopback works),
			// previews and the shared cloud dev deployment.
			"vars": { "ALLOWED_TARGETS": "https://*.convex.site,http://127.0.0.1:*,http://localhost:*" },
			"ratelimits": [{ "name": "CALLBACK_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }]
		},
		"prod": {
			"name": "onda-gateway",
			"routes": [{ "pattern": "gateway.onda.club", "zone_name": "onda.club", "custom_domain": true }],
			// Only the prod deployment. Fill in its CONVEX_SITE_URL once it exists.
			"vars": { "ALLOWED_TARGETS": "" },
			"ratelimits": [{ "name": "CALLBACK_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }]
		}
	}
}
